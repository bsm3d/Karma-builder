# BSM Karma Builder website - Apache settings (mod_rewrite, mod_headers)
Options -Indexes
DirectoryIndex index.php

# nothing that starts with a dot, and no leftover of the editor
<FilesMatch "^(\.|.*~$|.*\.(bak|sql|sqlite|log|inc\.php)$)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^sitemap\.xml$ sitemap.php [L]
  RewriteRule ^(guide|faq|contact)/?$ index.php?pg=$1 [L,QSA]
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
</IfModule>
