# BSM Karma Builder website - Apache settings (mod_headers, mod_expires)
Options -Indexes -MultiViews
DirectoryIndex index.html index.php
ErrorDocument 404 /404.html
ErrorDocument 403 /404.html

AddDefaultCharset UTF-8

# a page is read and a form is posted: nothing else is answered (PUT, DELETE, PATCH...).
# TRACE is answered before this point: TraceEnable Off in the server configuration is the only way to close it (it is the default of Debian and Ubuntu).
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{REQUEST_METHOD} !^(GET|POST|HEAD)$ [NC]
  RewriteRule .* - [F]
</IfModule>

# a form is a few kilobytes: nothing bigger is read (the PHP side checks too)
LimitRequestBody 65536

# no trace of the language or the server on the answers
<IfModule mod_headers.c>
  Header always unset X-Powered-By
</IfModule>
<IfModule mod_php.c>
  php_flag expose_php off
</IfModule>
<IfModule mod_php8.c>
  php_flag expose_php off
</IfModule>

# the headers that the static pages cannot send themselves; the PHP files send their own (so they are left out here: a header twice is a mess)
<IfModule mod_headers.c>
  <FilesMatch "^(?!.*\.php$)">
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data:; script-src 'self'; style-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
    Header always set Cross-Origin-Opener-Policy "same-origin"
    Header always set Cross-Origin-Resource-Policy "same-origin"
    # HTTPS only once the site is served over it: the browser then refuses plain HTTP for a year
    Header always set Strict-Transport-Security "max-age=31536000" "expr=%{HTTPS} == 'on'"
  </FilesMatch>
</IfModule>

# AI robots and AI assistants of every kind are shut out, the ones that fetch a page because a person asked included
# (robots.txt says the same, this one does not rely on good manners)
<IfModule mod_setenvif.c>
  SetEnvIfNoCase User-Agent "(GPTBot|ChatGPT-User|OAI-SearchBot|ClaudeBot|Claude-Web|Claude-User|Claude-SearchBot|anthropic-ai|CCBot|Bytespider|Amazonbot|meta-externalagent|meta-externalfetcher|FacebookBot|cohere-ai|Diffbot|ImagesiftBot|Omgilibot|omgili|PetalBot|Timpibot|Scrapy|ai2bot|PerplexityBot|Perplexity-User|MistralAI-User|DuckAssistBot|YouBot|Google-CloudVertexBot|GoogleAgent-Mariner)" ai_crawler
</IfModule>
<IfModule mod_authz_core.c>
  <RequireAll>
    Require all granted
    Require not env ai_crawler
  </RequireAll>
  # the one file that tells them they are not welcome stays readable by everyone
  <Files "robots.txt">
    Require all granted
  </Files>
</IfModule>

# nothing that starts with a dot, and no leftover of the editor
<FilesMatch "^(\.|.*~$|.*\.(bak|sql|sqlite|log|md|json|py|ini|sample|inc)$)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/html "access plus 10 minutes"
</IfModule>
